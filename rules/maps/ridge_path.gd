extends RefCounted
## 手で作ったマップ「尾根の小道」（docs/hand-map.md）。17 x 22 の小さめの盤。ストーリーの最初の話（game/episodes/ridge_path.gd）に使う。
##
## 本陣は上下の中央。盤の中心で点対称（本陣どうしを入れ替えると、同じ形になる）。
## 中央を壁でふさぎ、左右の道に分ける。左右の道それぞれに、結晶泉と中ボスを 1 つずつ置く（点対称）。
## 文字の意味は HandMap の定数。

const TITLE := "尾根の小道"
const ROWS: Array[String] = [
	"#.......2.......#",
	"#...............#",
	"..F...........F..",
	"..FF.........FF..",
	"....##.....##....",
	".....#.....#.....",
	"..F..#..B..#..F..",
	"..F.....F.....F..",
	"#...##..#..##...#",
	"..M...........*..",
	"....F..###..F....",
	"....F..###..F....",
	"..*...........M..",
	"#...##..#..##...#",
	"..F.....F.....F..",
	"..F..#..B..#..F..",
	".....#.....#.....",
	"....##.....##....",
	"..FF.........FF..",
	"..F...........F..",
	"#...............#",
	"#.......1.......#",
]


static func map() -> HandMap:
	return HandMap.new(PackedStringArray(ROWS))
